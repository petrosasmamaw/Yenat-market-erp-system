# Application stage (shown on login screen hints)
VITE_APP_STAGE=development

# Production: full backend URL (e.g. https://api.yourdomain.com)
# Development: leave empty — Vite proxies /api to the backend
VITE_API_URL=

# Dev proxy target when VITE_API_URL is empty
VITE_PROXY_TARGET=http://localhost:3000

# DISABLE_HMR=true
