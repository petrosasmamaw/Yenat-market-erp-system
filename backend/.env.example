# --- Application stage ---
NODE_ENV=development
APP_STAGE=development

# API server
PORT=3000

# JWT (replace demo secret before production)
JWT_SECRET=demo_yenat_jwt_secret_replace_with_long_random_string
JWT_EXPIRES_IN=7d

# Frontend URL(s), comma-separated
CORS_ORIGIN=http://localhost:5173

# Require Bearer JWT on protected API routes (set false only for local debugging)
REQUIRE_AUTH=true

# Neon PostgreSQL — paste your real connection string from Neon dashboard
# Leave empty to use local JSON file storage in development
DATABASE_URL=
# Alternative name (optional): NEON_DATABASE_URL=

# file = JSON only | neon = Neon only | hybrid = file + Neon (recommended when DATABASE_URL is set)
STORAGE_MODE=hybrid

# Local data directory (when using file/hybrid storage)
DATA_DIR=data
DATA_FILE=erp_store_state.json
